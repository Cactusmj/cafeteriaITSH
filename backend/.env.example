# Plantilla de variables de entorno del backend.
# Copiar a backend/.env y rellenar los valores reales.
# NUNCA subir backend/.env al repositorio.

# Entorno de ejecución
NODE_ENV=development
PORT=3000

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cafe_admin
DB_PASSWORD=
DB_NAME=cafeteria_itsh

# Autenticación
JWT_SECRET=

# Semilla de usuarios (solo desarrollo).
# Contraseña con la que se crean las cuentas base al ejecutar:
#   npm run seed:usuarios
SEED_PASSWORD=

# Proveedor de pago (sprint 3)
PAYMENT_PROVIDER=sandbox
PAYMENT_API_KEY=
# Modo del sandbox: exito | fallo (fallo simula un pago rechazado para pruebas)
PAYMENT_SANDBOX_MODO=exito
